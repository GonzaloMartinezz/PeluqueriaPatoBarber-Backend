# Copiá a .env y completá. Después cifralo con:  npx dotenvx encrypt
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/peluqueria_pato_barber

# Secretos: generá los tuyos, no reutilices estos.
#   JWT_SECRET      -> node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   ENCRYPTION_KEY  -> node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si perdés ENCRYPTION_KEY, los teléfonos y notas cifrados en la base NO se pueden recuperar.
JWT_SECRET=
ENCRYPTION_KEY=

# Orígenes del front (separados por coma). En producción: solo https.
CLIENT_URL=http://localhost:5173
# Cookies de sesión: lax (mismo sitio) | none (front y API en dominios distintos; exige https)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# Detrás de un proxy (Render, Railway, Nginx): cantidad de proxies, ej. 1
TRUST_PROXY=

# Cuenta del barbero (se crea al primer arranque). Usá una contraseña larga y única.
ADMIN_EMAIL=pato@barber.com
ADMIN_PASSWORD=123456
GOOGLE_CLIENT_ID=
